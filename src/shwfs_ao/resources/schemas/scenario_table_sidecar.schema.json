{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shwfs-ao.invalid/schemas/scenario_table_sidecar.schema.json",
  "title": "SHWFS-AO scenario CSV sidecar",
  "$ref": "#/$defs/sidecar",
  "$defs": {
    "sidecar": {
      "type": "object",
      "required": ["schema_name", "schema_version", "artifact_kind", "csv_filename", "csv_sha256", "header", "row_count", "row_order_key", "row_order", "field_units", "backend", "system_profile", "component_hashes", "layout_hashes", "provenance", "reproducibility"],
      "properties": {
        "schema_name": {"const": "shwfs_ao.scenario_table_sidecar"},
        "schema_version": {"const": 3},
        "artifact_kind": {"enum": ["run_result", "baseline_candidate", "accepted_regression_baseline"]},
        "csv_filename": {"type": "string", "pattern": "_error_budget\\.csv$"},
        "csv_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "header": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "row_count": {"type": "integer", "minimum": 1},
        "row_order_key": {"const": "scenario_name"},
        "row_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "field_units": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "backend": {"type": "string", "minLength": 1},
        "system_profile": {"type": "string", "minLength": 1},
        "component_hashes": {"$ref": "fast_reference_metrics.schema.json#/$defs/component_hashes"},
        "layout_hashes": {"$ref": "fast_reference_metrics.schema.json#/$defs/layout_hashes"},
        "provenance": {"$ref": "provenance.schema.json"},
        "reproducibility": {"$ref": "fast_reference_metrics.schema.json#/$defs/reproducibility"},
        "candidate": {"type": "object", "minProperties": 1},
        "diff": {"type": "object", "minProperties": 1},
        "acceptance": {
          "type": "object",
          "required": ["reason", "review_reference"],
          "properties": {
            "reason": {"type": "string", "minLength": 1},
            "review_reference": {"type": "string", "minLength": 1}
          }
        }
      },
      "oneOf": [
        {
          "properties": {"artifact_kind": {"const": "run_result"}},
          "not": {"anyOf": [{"required": ["candidate"]}, {"required": ["diff"]}, {"required": ["acceptance"]}]}
        },
        {
          "required": ["candidate", "diff"],
          "properties": {
            "artifact_kind": {"const": "baseline_candidate"},
            "reproducibility": {"$ref": "fast_reference_metrics.schema.json#/$defs/governed_source_evidence"}
          },
          "not": {"required": ["acceptance"]}
        },
        {
          "required": ["acceptance"],
          "properties": {
            "artifact_kind": {"const": "accepted_regression_baseline"},
            "reproducibility": {"$ref": "fast_reference_metrics.schema.json#/$defs/governed_source_evidence"}
          },
          "not": {"anyOf": [{"required": ["candidate"]}, {"required": ["diff"]}]}
        }
      ]
    }
  }
}
