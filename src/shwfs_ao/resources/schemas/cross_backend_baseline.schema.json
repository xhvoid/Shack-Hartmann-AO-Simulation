{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shwfs-ao.invalid/schemas/cross_backend_baseline.schema.json",
  "title": "SHWFS-AO cross-backend physical comparison baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "artifact_kind",
    "system_profile",
    "backends",
    "shared_input_hashes",
    "estimator",
    "sample_definition",
    "bin_definition",
    "metrics",
    "tolerances",
    "provenance",
    "reproducibility",
    "acceptance"
  ],
  "properties": {
    "schema_name": {"const": "shwfs_ao.cross_backend_baseline"},
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "accepted_cross_backend_baseline"},
    "system_profile": {"type": "string", "minLength": 1},
    "backends": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "shared_input_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}
    },
    "estimator": {"type": "object", "minProperties": 1},
    "sample_definition": {"type": "object", "minProperties": 1},
    "bin_definition": {"type": "object", "minProperties": 1},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "object", "minProperties": 1}},
    "tolerances": {"type": "array", "minItems": 1, "items": {"type": "object", "minProperties": 1}},
    "provenance": {"$ref": "provenance.schema.json"},
    "reproducibility": {"type": "object", "minProperties": 1},
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "review_reference"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "review_reference": {"type": "string", "minLength": 1}
      }
    }
  }
}
