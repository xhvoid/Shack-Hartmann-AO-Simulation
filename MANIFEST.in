include README.md
include LICENSE
include DATA_LICENSES.md
include src/shwfs_ao/DATA_LICENSES.md
include pyproject.toml
include MANIFEST.in

# Runtime modules, compatibility imports and packaging helpers.
include src/*.py
recursive-include src/shwfs_ao *.py
recursive-include build_support *.py

# The compatibility resource alias is generated during the build.
recursive-include src/shwfs_ao/resources *.md
recursive-include src/shwfs_ao/resources *.csv
recursive-include src/shwfs_ao/resources *.json

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
